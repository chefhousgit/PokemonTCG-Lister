# =============================================================================
# PokemonTCG-Lister — Environment Variables
# Copy to .env for local development. Set the same keys in Railway.
# Never commit a filled .env.
# =============================================================================

PORT=3001
NODE_ENV=development

# Leave empty to disable login locally. Set a password in production.
APP_PASSWORD=
SESSION_SECRET=

# Railway Postgres. Leave empty locally to use in-process PGlite.
DATABASE_URL=

# Optional — Claude listing drafts
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6

# Shared token the local Windows agent sends. Rotate if leaked.
AGENT_TOKEN=

# mock | manual
MARKETPLACE_ADAPTER=manual

# manual | stub
TRADE_EXECUTOR=manual

# Leave false until you have official Eldorado docs + 50 sales.
ELDORADO_ENABLED=false

# Optional fallback only. Prefer Settings → PTCGPB folders in the app
# so each computer can store its own path.
# PTCGPB_ROOT=
